[Unit]
Description=Fleet frontend: fetch runtime config from AWS SSM into the nginx snippet
After=network-online.target nginx.service
Wants=network-online.target

[Service]
# oneshot + RemainAfterExit: fetch at boot, then stay active. The deploy restarts
# it to apply an SSM change. By hand: sudo systemctl restart fleet-app-frontend-runtime-fetch
# Prefix fleet-app-: `fleet-` is reserved for box-wide units (fleet-db-backup).
Type=oneshot
RemainAfterExit=yes
User=root
UMask=0027

# Force the EC2 instance role over IMDS by blanking root's static certbot-route53
# keys. The frontend config is public String: no kms:Decrypt needed.
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_REGION=eu-west-1

# §3.10: runs as root, so the script lives outside the app tree
# (/usr/local/sbin, installed by the deploy from root's mirror).
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/nginx/snippets
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
TimeoutStartSec=120

ExecStart=/usr/local/sbin/fleet-app-frontend-runtime-fetch.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
